# Template only. Copy to .env and fill in real values — .env is git-ignored, never commit it.

# Postgres/Supabase connection string used by the ASP.NET Core API (EF Core).
DATABASE_URL=

# Symmetric signing key for API-issued JWTs. Long random string, min 32 characters.
JWT_SECRET=

# Issuer claim ("iss") the API stamps on tokens and validates on the way back in.
JWT_ISSUER=

# Audience claim ("aud") the API expects — the React and Flutter clients.
JWT_AUDIENCE=

# Base URL of the Python FastAPI agent service. Called by the API only, never by clients.
AGENT_SERVICE_URL=

# Seconds the API waits for one agent POST /run before giving up. Default 60 — generous,
# because a real clarifier run takes about ten seconds and the agent retries once itself.
AGENT_TIMEOUT_SECONDS=

# Base URL of the ASP.NET Core API, read by the agent service so it can call back into
# /api/internal/tools/*. This is the agent's ONLY route to campus data.
API_BASE_URL=

# Shared secret for the API <-> agent service channel, in both directions: the API sends it
# to the agent, and the agent sends it back in the X-Agent-Secret header on every call to
# /api/internal/tools/*. Leave empty and those endpoints reject everything with 401.
AGENT_SHARED_SECRET=

# Base URL of the LLM provider the agent service talks to.
LLM_BASE_URL=

# API key for the LLM provider. Lives in the agent service only.
LLM_API_KEY=

# Model identifier the agent service requests, e.g. the provider's model name.
LLM_MODEL=

# Seconds the agent service waits for the LLM provider before giving up. Default 30.
LLM_TIMEOUT_SECONDS=

# Seconds the agent service waits for an API tool call before giving up. Default 10.
TOOL_TIMEOUT_SECONDS=

# Set true to make the agent service return fixed valid JSON with no LLM or API calls.
# Used by its pytest suite; leave empty everywhere else.
STUB_MODE=

# Supabase project URL.
SUPABASE_URL=

# Supabase service role key. Server-side only — never expose it to the web or mobile client.
SUPABASE_SERVICE_KEY=

# Supabase Storage bucket that report photos are uploaded to. Must be a PUBLIC bucket.
# Default "photos". Not a secret — only the object URL is stored in Postgres.
SUPABASE_STORAGE_BUCKET=

# Work order cost in LKR above which a manager must approve before any work is scheduled.
# Default 15000. Read by the API only — the approval comparison itself is C#, never a prompt.
APPROVAL_COST_THRESHOLD=

# Days after a work order completes before the reporter is asked whether the repair held,
# and before its workflow moves from Completed to AwaitingVerification.
# Default 5. The delay is the point: asked the same day, every answer is yes.
VERIFICATION_DELAY_DAYS=

# Minutes between sweeps for verification checks that have come due. Default 60.
VERIFICATION_SWEEP_INTERVAL_MINUTES=

# Days a reporter has to answer a verification check before it goes to the agent anyway. Default 3.
VERIFICATION_RESPONSE_WINDOW_DAYS=

# IANA time zone the campus working day is measured in. Default Asia/Colombo.
SCHEDULING_TIME_ZONE=

# Campus-local start and end of the bookable working day, HH:mm. Defaults 08:00 and 17:00.
SCHEDULING_WORKDAY_START=
SCHEDULING_WORKDAY_END=

# Minutes kept clear before and after every class when offering maintenance slots. Default 15.
SCHEDULING_CLASS_BUFFER_MINUTES=

# Base64 of the Google service account's JSON key file (base64 -i key.json). The API reads
# the "Campus Timetable" calendar as this account — no OAuth, no user login. A secret: never
# commit the key or this value. Leave empty and the timetable does not sync.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Calendar ID of the "Campus Timetable" Google Calendar (Settings -> Integrate calendar),
# shared read-only with the service account's email address.
GOOGLE_CALENDAR_ID=

# Seconds one timetable sync waits on Google before serving the cached timetable. Default 10.
GOOGLE_CALENDAR_TIMEOUT_SECONDS=

# Minutes between scheduled timetable syncs. Default 60. POST /api/timetable/sync runs one now.
TIMETABLE_SYNC_INTERVAL_MINUTES=

# Allowed CORS origin for the React dev server, read by the API's "Clients" policy.
# Add further origins as Cors__AllowedOrigins__1, __2, ...
Cors__AllowedOrigins__0=

# Development-only demo account passwords used by the API seeder, one per role.
# Leave empty outside development — a blank value simply skips seeding that user.
Seed__Passwords__Reporter=
Seed__Passwords__Technician=
Seed__Passwords__FacilitiesManager=
Seed__Passwords__Admin=

# Web client configuration lives in web/.env (see web/.env.example) — Vite only reads keys
# prefixed with VITE_ and exposes them to the browser, so nothing secret belongs there.
