// MaintenX database schema (PostgreSQL), for dbdiagram.io.
//
// Transcribed from the EF Core model snapshot
// api/Data/Migrations/AppDbContextModelSnapshot.cs (18 migrations, the last being
// 20261002143809_AddAgentStepTokenUsage) and api/Data/AppDbContext.cs.
// Every table, column, type, nullability, key, index, delete rule and CHECK constraint below
// is what `dotnet ef database update` creates. EF's own __EFMigrationsHistory table is left out.
//
// Conventions that apply to every table:
//   * Id is an identity column (GENERATED BY DEFAULT AS IDENTITY).
//   * CreatedAt / UpdatedAt are stamped by AppDbContext.ApplyTimestamps on every save, in UTC.
//   * Enums are stored as their NAME in varchar(50), never as an ordinal. The allowed values
//     are listed in each column's note.
//   * timestamptz = "timestamp with time zone" (always UTC). date = a calendar date (DateOnly).
//   * Money is numeric(18,2), never a floating-point type.

Project MaintenX {
  database_type: 'PostgreSQL'
  Note: '''
  Campus facilities maintenance: a fault is followed from report to verified repair.
  15 tables in five groups: identity, estate and asset registry, fault reporting and
  clarification, agent workflow state, work orders and scheduling, verification.
  Delete rule is RESTRICT everywhere history must survive; CASCADE only for rows that mean
  nothing without their parent (rooms of a building, steps of a workflow, the answer to a
  question, the booked slots of a work order).
  '''
}

// ---------------------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------------------

Table Users {
  Id integer [pk, increment]
  Email varchar(256) [not null, note: 'Stored lower-cased; unique']
  FullName varchar(200) [not null]
  PasswordHash text [not null, note: 'ASP.NET Core PasswordHasher<User> hash. Never returned by any DTO']
  Role varchar(50) [not null, note: 'Reporter | Technician | FacilitiesManager | Admin']
  IsActive boolean [not null, default: true, note: 'Deactivation instead of deletion. An inactive account cannot sign in']
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz [not null]

  indexes {
    Email [unique, name: 'IX_Users_Email']
  }

  Note: 'Hand-rolled JWT auth. A user is never deleted: reports, answers and work orders point here with RESTRICT keys.'
}

// ---------------------------------------------------------------------------------------
// Estate and asset registry
// ---------------------------------------------------------------------------------------

Table Buildings {
  Id integer [pk, increment]
  Name varchar(200) [not null]
  Code varchar(20) [not null, note: 'Unique, e.g. MAB']
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz [not null]

  indexes {
    Code [unique, name: 'IX_Buildings_Code']
  }
}

Table Rooms {
  Id integer [pk, increment]
  BuildingId integer [not null]
  Name varchar(200) [not null]
  Code varchar(20) [not null, note: 'e.g. MAB-101. The timetable sync matches Google Calendar event locations to this code']
  Floor integer [not null]
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz [not null]

  indexes {
    BuildingId [name: 'IX_Rooms_BuildingId']
  }
}

Table AssetCategories {
  Id integer [pk, increment]
  Name varchar(100) [not null, note: 'Unique, e.g. Projector']
  DefaultWarrantyMonths integer [not null, note: 'A data-entry default only; each asset stores its own expiry date']
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz [not null]

  indexes {
    Name [unique, name: 'IX_AssetCategories_Name']
  }

  Note: 'No DELETE endpoint: assets reference categories with RESTRICT.'
}

Table Assets {
  Id integer [pk, increment]
  AssetTag varchar(50) [not null, note: 'The QR payload. Unique across the estate and not editable after registration']
  Name varchar(200) [not null]
  AssetCategoryId integer [not null]
  RoomId integer [not null]
  Manufacturer varchar(100)
  Model varchar(100)
  InstalledOn date [not null]
  WarrantyExpiresOn date [note: 'Null = no warranty recorded (read as not covered). Covered up to and including this date']
  Status varchar(50) [not null, note: 'Active | UnderMaintenance | Retired. Retired is how an asset leaves; rows are never deleted']
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz [not null]

  indexes {
    AssetTag [unique, name: 'IX_Assets_AssetTag']
    AssetCategoryId [name: 'IX_Assets_AssetCategoryId']
    RoomId [name: 'IX_Assets_RoomId']
  }
}

Table ServiceRecords {
  Id integer [pk, increment]
  AssetId integer [not null]
  ServicedOn date [not null]
  TechnicianName varchar(200) [not null]
  TechnicianNote varchar(2000) [note: 'Verbatim; the diagnostic agent reads it months later']
  Outcome varchar(50) [not null, note: 'Resolved | TemporaryFix | PartReplaced | NoFaultFound']
  WorkOrderId integer [note: 'Null for seeded or imported history that no work order produced']
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz [not null]

  indexes {
    AssetId [name: 'IX_ServiceRecords_AssetId']
    ServicedOn [name: 'IX_ServiceRecords_ServicedOn']
    WorkOrderId [name: 'IX_ServiceRecords_WorkOrderId']
  }

  Note: 'Immutable history. Appended by a completed work order; deliberately not the same table as WorkOrders.'
}

// ---------------------------------------------------------------------------------------
// Fault reporting and clarification
// ---------------------------------------------------------------------------------------

Table Reports {
  Id integer [pk, increment]
  ReporterId integer [not null, note: 'Taken from the JWT sub claim, never from the request body']
  RoomId integer [not null]
  AssetId integer [note: 'Optional: set by a QR scan when filing. Must be an asset in RoomId']
  Description varchar(1000) [not null, note: 'The reporter\'s words; becomes the workflow objective verbatim']
  PhotoUrl varchar(500) [note: 'Public Supabase Storage URL. The image bytes are never stored here']
  Status varchar(50) [not null, note: 'Submitted | AwaitingClarification | Clarified | Diagnosed | WorkOrderRaised | Closed']
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz [not null]

  indexes {
    ReporterId [name: 'IX_Reports_ReporterId']
    RoomId [name: 'IX_Reports_RoomId']
    AssetId [name: 'IX_Reports_AssetId']
    Status [name: 'IX_Reports_Status']
    CreatedAt [name: 'IX_Reports_CreatedAt']
  }
}

Table ClarificationQuestions {
  Id integer [pk, increment]
  ReportId integer [not null]
  WorkflowId integer [not null, note: 'Which agent run asked it']
  QuestionText varchar(300) [not null]
  AnswerType varchar(50) [not null, note: 'YesNo | SingleSelect | ShortText (the whole list: there is no free-text type)']
  OptionsJson jsonb [note: 'The fixed options; set only for SingleSelect']
  DisplayOrder integer [not null]
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz [not null]

  indexes {
    ReportId [name: 'IX_ClarificationQuestions_ReportId']
    WorkflowId [name: 'IX_ClarificationQuestions_WorkflowId']
  }

  Note: 'The working copy of the clarifier\'s questions. The audit copy is the clarifier step\'s PayloadJson.'
}

Table ClarificationAnswers {
  Id integer [pk, increment]
  ClarificationQuestionId integer [not null, note: 'Unique: one answer per question']
  AnsweredByUserId integer [not null]
  AnswerText varchar(100) [not null, note: '"Yes"/"No", one of the stored options, or short text of up to 100 characters']
  AnsweredAt timestamptz [not null]
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz [not null]

  indexes {
    ClarificationQuestionId [unique, name: 'IX_ClarificationAnswers_ClarificationQuestionId']
    AnsweredByUserId [name: 'IX_ClarificationAnswers_AnsweredByUserId']
  }
}

// ---------------------------------------------------------------------------------------
// Agent workflow state (the durable shared state of every agent run)
// ---------------------------------------------------------------------------------------

Table AgentWorkflows {
  Id integer [pk, increment]
  ReportId integer [note: 'Null only for a run started from a bare objective']
  Objective varchar(1000) [not null, note: 'The domain objective: the report description']
  CurrentState varchar(50) [not null, note: 'Submitted | AwaitingClarification | Diagnosing | Strategizing | AwaitingManagerApproval | WorkOrderRaised | InProgress | Completed | AwaitingVerification | Closed | Failed. Changed only through WorkflowTransitions.Move']
  PlanJson jsonb [note: 'The structured plan (planner or fallback), written only by WorkflowService.SetPlanAsync']
  Outcome varchar(2000) [note: 'Final result, or the recorded reason for a safe failure']
  ReopenedWorkOrderId integer [note: 'Set when the reporter said a repair did not hold']
  StartedAt timestamptz
  CompletedAt timestamptz [note: 'Stamped with the work order CompletedAt; the verification sweep measures its delay from here']
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz [not null]

  indexes {
    CurrentState [name: 'IX_AgentWorkflows_CurrentState']
    ReportId [name: 'IX_AgentWorkflows_ReportId']
    ReopenedWorkOrderId [name: 'IX_AgentWorkflows_ReopenedWorkOrderId']
  }
}

Table AgentSteps {
  Id integer [pk, increment]
  WorkflowId integer [not null]
  AgentName varchar(100) [not null, note: 'planner | clarifier | diagnostic | strategist | verification | approval']
  ToolCallsJson jsonb [note: '"[]" on an agent-run step; a tool-call step is written by the tool router; null on an approval step']
  PayloadJson jsonb [note: 'The agent output or tool result verbatim. Never edited']
  ValidationResult varchar(100) [note: 'Ok | NotFound | RejectedUnknownTool | SafeFailure | CallFailed | Rejected, or an approval tag: ApprovalRequired | AutoApproved | ManagerApproved | ManagerRejected | RevisionRequested']
  ErrorMessage varchar(2000)
  DurationMs integer [not null, note: 'The agent\'s own time, as reported by the agent service']
  Attempts integer [note: 'LLM attempts: 1, or 2 after the single retry. Null for tool and approval steps']
  PromptTokens integer [note: 'Tokens the provider reported, both attempts added. Null when none were reported']
  CompletionTokens integer [note: 'As PromptTokens, for the reply']
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz [not null]

  indexes {
    WorkflowId [name: 'IX_AgentSteps_WorkflowId']
  }

  Note: 'The audit trail: one row per agent run, per tool call (allowed or rejected) and per approval decision.'
}

// ---------------------------------------------------------------------------------------
// Work orders and scheduling
// ---------------------------------------------------------------------------------------

Table WorkOrders {
  Id integer [pk, increment]
  ReportId integer [not null]
  AssetId integer [not null, note: 'Not nullable: nobody can be sent to repair an unidentified machine']
  Strategy varchar(50) [not null, note: 'KnownFix | SingleJob | ConsolidatedJob | InspectFirst | Defer | EscalateReplacement']
  Status varchar(50) [not null, note: 'Draft | AwaitingApproval | Approved | Rejected | Scheduled | InProgress | Completed | Cancelled']
  EstimatedCost numeric(18,2) [not null, note: 'LKR. Above Approval:CostThreshold (default 15000), or EscalateReplacement, needs a manager']
  ActualCost numeric(18,2) [note: 'Null until completed']
  PartsRequired varchar(1000)
  AssignedTechnicianId integer
  ApprovedByUserId integer [note: 'The manager who approved or rejected. Null when the gate auto-approved']
  ApprovedAt timestamptz
  RejectionReason varchar(1000)
  RevisionNote varchar(1000) [note: 'The manager\'s note when sent back for revision (order returns to Draft)']
  DueAt timestamptz [note: 'Repair SLA, stamped at approval (default 7 days). Null = no SLA clock']
  CompletedAt timestamptz
  ResolutionNote varchar(2000) [note: 'At least 20 characters; copied verbatim into the ServiceRecord']
  CompletionPhotoUrl varchar(500)
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz [not null]

  indexes {
    ReportId [name: 'IX_WorkOrders_ReportId']
    AssetId [name: 'IX_WorkOrders_AssetId']
    AssignedTechnicianId [name: 'IX_WorkOrders_AssignedTechnicianId']
    ApprovedByUserId [name: 'IX_WorkOrders_ApprovedByUserId']
    Status [name: 'IX_WorkOrders_Status']
  }

  checks {
    `"EstimatedCost" >= 0` [name: 'CK_WorkOrders_EstimatedCost_NotNegative']
    `"ActualCost" IS NULL OR "ActualCost" >= 0` [name: 'CK_WorkOrders_ActualCost_NotNegative']
  }
}

Table ScheduledSlots {
  Id integer [pk, increment]
  WorkOrderId integer [not null]
  StartsAt timestamptz [not null]
  EndsAt timestamptz [not null]
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz [not null]

  indexes {
    WorkOrderId [name: 'IX_ScheduledSlots_WorkOrderId']
  }

  checks {
    `"EndsAt" > "StartsAt"` [name: 'CK_ScheduledSlots_EndsAfterStart']
  }

  Note: 'A booked technician visit. Its own table so a job can take several visits and a reschedule adds a row.'
}

Table ClassScheduleSlots {
  Id integer [pk, increment]
  RoomId integer [not null]
  Title varchar(200) [not null]
  StartsAt timestamptz [not null]
  EndsAt timestamptz [not null]
  ExternalEventId varchar(200) [not null, note: 'Google Calendar event id. Unique, which makes a re-sync idempotent']
  SyncedAt timestamptz [not null, note: 'Last confirmed by a sync. Distinct from UpdatedAt (last changed)']
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz [not null]

  indexes {
    ExternalEventId [unique, name: 'IX_ClassScheduleSlots_ExternalEventId']
    RoomId [name: 'IX_ClassScheduleSlots_RoomId']
    StartsAt [name: 'IX_ClassScheduleSlots_StartsAt']
  }

  checks {
    `"EndsAt" > "StartsAt"` [name: 'CK_ClassScheduleSlots_EndsAfterStart']
  }

  Note: 'Mirrored from the campus timetable in Google Calendar, never authored here. The slot finder reads only this table.'
}

// ---------------------------------------------------------------------------------------
// Verification
// ---------------------------------------------------------------------------------------

Table VerificationChecks {
  Id integer [pk, increment]
  WorkOrderId integer [not null, note: 'NOT unique: a reopened fault gets a new work order with its own check']
  AssetId integer [not null]
  Status varchar(50) [not null, note: 'Pending | AwaitingReporterResponse | Confirmed | Reopened | Escalated | Expired. Set by C# from the reporter\'s answer']
  DueAt timestamptz [not null, note: 'Completion + Verification:DelayDays (default 5), stamped when the check is raised']
  ProcessedAt timestamptz [note: 'When the sweep asked the reporter']
  ReporterConfirmed boolean [note: 'Null = not answered, which is not the same fact as false']
  ReporterComment varchar(500) [note: 'The API accepts at most 300 characters']
  ReporterRespondedAt timestamptz
  ExpiredReason varchar(500)
  AgentQueuedAt timestamptz [note: 'Handed to the verification agent. The row is the queue']
  AgentJudgedAt timestamptz [note: 'Judged, or given up on, since the last queue stamp']
  AgentAttempts integer [not null, default: 0, note: 'Agent calls against the current queue stamp (at most 3)']
  AgentOutcome varchar(100) [note: 'confirm | reopen | escalate. The model\'s opinion, a string nothing acts on']
  AgentReason varchar(2000)
  AgentEvidenceJson jsonb [note: 'The agent\'s one to five evidence strings, verbatim']
  AgentError varchar(500) [note: 'The system\'s reason when no verdict could be reached']
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz [not null]

  indexes {
    (Status, DueAt) [name: 'IX_VerificationChecks_Status_DueAt', note: 'The sweep query: equality on Status, range on DueAt']
    WorkOrderId [name: 'IX_VerificationChecks_WorkOrderId']
    AssetId [name: 'IX_VerificationChecks_AssetId']
  }
}

// ---------------------------------------------------------------------------------------
// Relationships (23 foreign keys)
// ---------------------------------------------------------------------------------------

// Estate and registry
Ref FK_Rooms_Buildings_BuildingId: Rooms.BuildingId > Buildings.Id [delete: cascade]
Ref FK_Assets_AssetCategories_AssetCategoryId: Assets.AssetCategoryId > AssetCategories.Id [delete: restrict]
Ref FK_Assets_Rooms_RoomId: Assets.RoomId > Rooms.Id [delete: restrict]
Ref FK_ServiceRecords_Assets_AssetId: ServiceRecords.AssetId > Assets.Id [delete: restrict]
Ref FK_ServiceRecords_WorkOrders_WorkOrderId: ServiceRecords.WorkOrderId > WorkOrders.Id [delete: restrict]

// Reports and clarification
Ref FK_Reports_Users_ReporterId: Reports.ReporterId > Users.Id [delete: restrict]
Ref FK_Reports_Rooms_RoomId: Reports.RoomId > Rooms.Id [delete: restrict]
Ref FK_Reports_Assets_AssetId: Reports.AssetId > Assets.Id [delete: restrict]
Ref FK_ClarificationQuestions_Reports_ReportId: ClarificationQuestions.ReportId > Reports.Id [delete: restrict]
Ref FK_ClarificationQuestions_AgentWorkflows_WorkflowId: ClarificationQuestions.WorkflowId > AgentWorkflows.Id [delete: restrict]
Ref FK_ClarificationAnswers_ClarificationQuestions_ClarificationQuestionId: ClarificationAnswers.ClarificationQuestionId - ClarificationQuestions.Id [delete: cascade]
Ref FK_ClarificationAnswers_Users_AnsweredByUserId: ClarificationAnswers.AnsweredByUserId > Users.Id [delete: restrict]

// Agent workflow state
Ref FK_AgentWorkflows_Reports_ReportId: AgentWorkflows.ReportId > Reports.Id [delete: restrict]
Ref FK_AgentWorkflows_WorkOrders_ReopenedWorkOrderId: AgentWorkflows.ReopenedWorkOrderId > WorkOrders.Id [delete: restrict]
Ref FK_AgentSteps_AgentWorkflows_WorkflowId: AgentSteps.WorkflowId > AgentWorkflows.Id [delete: cascade]

// Work orders and scheduling
Ref FK_WorkOrders_Reports_ReportId: WorkOrders.ReportId > Reports.Id [delete: restrict]
Ref FK_WorkOrders_Assets_AssetId: WorkOrders.AssetId > Assets.Id [delete: restrict]
Ref FK_WorkOrders_Users_AssignedTechnicianId: WorkOrders.AssignedTechnicianId > Users.Id [delete: restrict]
Ref FK_WorkOrders_Users_ApprovedByUserId: WorkOrders.ApprovedByUserId > Users.Id [delete: restrict]
Ref FK_ScheduledSlots_WorkOrders_WorkOrderId: ScheduledSlots.WorkOrderId > WorkOrders.Id [delete: cascade]
Ref FK_ClassScheduleSlots_Rooms_RoomId: ClassScheduleSlots.RoomId > Rooms.Id [delete: restrict]

// Verification
Ref FK_VerificationChecks_WorkOrders_WorkOrderId: VerificationChecks.WorkOrderId > WorkOrders.Id [delete: restrict]
Ref FK_VerificationChecks_Assets_AssetId: VerificationChecks.AssetId > Assets.Id [delete: restrict]

// ---------------------------------------------------------------------------------------
// Groups (drawn as boxes in dbdiagram.io)
// ---------------------------------------------------------------------------------------

TableGroup identity_and_estate [color: #5B50E8] {
  Users
  Buildings
  Rooms
}

TableGroup asset_registry [color: #2F855A] {
  AssetCategories
  Assets
  ServiceRecords
}

TableGroup reporting_and_clarification [color: #B7791F] {
  Reports
  ClarificationQuestions
  ClarificationAnswers
}

TableGroup agent_workflow_state [color: #6B46C1] {
  AgentWorkflows
  AgentSteps
}

TableGroup work_orders_and_scheduling [color: #C05621] {
  WorkOrders
  ScheduledSlots
  ClassScheduleSlots
}

TableGroup verification [color: #B42318] {
  VerificationChecks
}
