%%{init: {'theme': 'base', 'themeVariables': {'fontFamily': 'Arial, Helvetica, sans-serif', 'fontSize': '15px', 'lineColor': '#6B7280', 'primaryTextColor': '#15171C'}}}%%
%% The agent graph (agent/graph.py), SIMPLIFIED for the report (Figure 3.2): five agents, the
%% routing decisions in plain words, and where each run hands back to the API. The version with
%% the exact Python routing conditions is agent-graph-full.mmd.

flowchart TD
    START(["API calls POST /run"])
    ROUTE{"What does the<br/>request carry?"}

    PLAN["<b>Planner</b><br/><i>no tools</i>"]
    NEED{"Does the plan include<br/>the clarifier?"}
    CLAR["<b>Clarifier</b><br/><i>room · asset</i>"]
    ASKED{"Any questions<br/>to ask?"}
    DIAG["<b>Diagnostic</b><br/><i>asset · service history · open reports</i>"]
    STRAT["<b>Resolution Strategist</b><br/><i>asset · service history · open work orders</i>"]
    VERIFY["<b>Verification</b><br/><i>work order · service history · open reports</i>"]

    PAUSE(["Pause: wait for<br/>the reporter's answers"])
    GATE(["Back to the API:<br/>C# approval gate"])
    VERDICT(["Back to the API:<br/>verdict stored as advice"])

    START --> ROUTE
    ROUTE -- "new report" --> PLAN
    ROUTE -- "answers, or a<br/>reopened repair" --> DIAG
    ROUTE -- "manager's<br/>revision note" --> STRAT
    ROUTE -- "repair to verify" --> VERIFY

    PLAN --> NEED
    NEED -- "yes (or no valid plan)" --> CLAR
    NEED -- "no" --> DIAG
    CLAR --> ASKED
    ASKED -- "yes" --> PAUSE
    ASKED -- "no" --> DIAG

    DIAG --> STRAT
    STRAT --> GATE
    VERIFY --> VERDICT

    classDef agent fill:#E8E6FC,stroke:#5B50E8,stroke-width:1.5px,color:#15171C
    classDef planner fill:#F3E8FF,stroke:#6B46C1,stroke-width:1.5px,color:#15171C
    classDef decision fill:#FFF7E0,stroke:#B7791F,color:#15171C
    classDef terminal fill:#EEF0F3,stroke:#15171C,color:#15171C
    classDef pause fill:#FFFFFF,stroke:#5B50E8,stroke-width:2px,stroke-dasharray: 5 3,color:#15171C
    class CLAR,DIAG,STRAT,VERIFY agent
    class PLAN planner
    class ROUTE,NEED,ASKED decision
    class START,GATE,VERDICT terminal
    class PAUSE pause
