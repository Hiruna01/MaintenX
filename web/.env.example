# Template only. Copy to .env and fill in real values — .env is git-ignored, never commit it.
# Only VITE_-prefixed keys reach the browser, and everything here is public by definition:
# never put a secret in this file.

# Base URL of the ASP.NET Core API. The React app talks ONLY to this API, never to the
# Python agent service. Defaults to http://localhost:5138 (the API's http launch profile).
VITE_API_BASE_URL=
